# Copy to frontend/.env.local. Never commit .env.local.

# Ordis FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Testing on a phone through a tunnel (ngrok http 3000): use the built-in API proxy instead, so one
# tunnel serves the site and the API:  NEXT_PUBLIC_API_URL=/ordis-api
# (ORDIS_API_PROXY sets where /ordis-api forwards; default http://localhost:8000)

# Clerk (free dev instance: https://dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Optional: Google Maps Embed API key for the Street View panel (the aerial view needs no key)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Local development only: open /viewer without signing in
# ORDIS_DISABLE_AUTH=true
