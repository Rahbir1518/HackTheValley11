# Copy to frontend/.env.local. Never commit .env.local.

# Ordis FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk (free dev instance: https://dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Optional: Google Maps Embed API key for the Street View panel (the aerial view needs no key)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Local development only: open /viewer without signing in
# ORDIS_DISABLE_AUTH=true
