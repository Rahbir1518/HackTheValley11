# Copy to .env and fill in. Never commit .env.

# Full path to the Blender executable (Blender 4.2+; developed on 5.2)
BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe

# LLM provider: gemini | groq | openrouter   (added in milestone 2)
LLM_PROVIDER=gemini
# Backups used automatically when the primary's free quota runs out (only those with a key)
LLM_FALLBACKS=groq,openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# "From the street" photomontage: a Google Maps Platform key with the Street View Static API
# enabled (billing account required; 10,000 free photos a month). Server-side only, never sent
# to the browser. Photos are cached, so cached views keep working if the key is removed.
GOOGLE_MAPS_API_KEY=
