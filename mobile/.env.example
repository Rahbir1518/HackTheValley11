# Copy to .env.local (gitignored).
# Same Clerk instance as the web app (frontend/.env.local NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Android emulator: `npm run ports` maps the emulator's localhost to your computer.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_WEB_URL=http://localhost:3000
# Real phone through ngrok (`ngrok http 3000`, web app with NEXT_PUBLIC_API_URL=/ordis-api):
# EXPO_PUBLIC_API_URL=https://<your-name>.ngrok-free.app/ordis-api
# EXPO_PUBLIC_WEB_URL=https://<your-name>.ngrok-free.app
